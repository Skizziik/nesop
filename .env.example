# Скопируй в .env:  cp .env.example .env   (Windows: copy .env.example .env)

# Профиль: cpu (по умолчанию, работает везде) или gpu (NVIDIA + NVIDIA Container Toolkit в WSL2)
COMPOSE_PROFILES=cpu

# Порты на хосте
WEB_PORT=3000
API_PORT=8000

# Postgres
POSTGRES_USER=farm
POSTGRES_PASSWORD=farm
POSTGRES_DB=farm

# LLM (этап 3). Без ключа всё работает из банка уроков.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b

# Озвучка по умолчанию (голос ставится автоматически при первом запуске)
DEFAULT_TTS_MODEL=piper
DEFAULT_TTS_VOICE=it_IT-serena-medium
DEFAULT_TTS_SPEED=0.92

# Производительность
WORKER_MAX_JOBS=2
RENDER_CONCURRENCY=1
# Потоков Chromium на один рендер (пусто = половина ядер)
RENDER_THREADS=

# Поздние этапы (выключено)
YOUTUBE_UPLOAD_ENABLED=false
MAX_PUBLISH_PER_DAY=3
