{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "formats/conjugation_challenge.schema.json",
  "title": "ConjugationChallengeBody",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verb",
    "tense",
    "forms",
    "hidden"
  ],
  "properties": {
    "verb": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "tense": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "description": "Время, напр. «presente», «passato prossimo»"
    },
    "forms": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 22
      },
      "description": "io, tu, lui/lei, noi, voi, loro"
    },
    "hidden": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5
      },
      "description": "Какие формы спрятать"
    },
    "reveal": {
      "type": "boolean",
      "default": false
    }
  },
  "description": "Таблица спряжения, одна-две формы скрыты (не обязательно последняя)."
}
